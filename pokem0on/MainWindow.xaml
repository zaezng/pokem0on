<Window x:Class="pokem0on.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pokédex"
        Width="1180" Height="700"
        MinWidth="1180" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#FFEFEFEF"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- Fonts -->
        <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

        <!-- Colors -->
        <Color x:Key="Red1">#FFCF1F2A</Color>
        <Color x:Key="Red2">#FFB81822</Color>
        <Color x:Key="Panel">#FFF7F7F7</Color>
        <Color x:Key="Stroke">#FFE2E2E2</Color>
        <Color x:Key="Ink">#FF1D1D1D</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BrushRed1" Color="{StaticResource Red1}"/>
        <SolidColorBrush x:Key="BrushRed2" Color="{StaticResource Red2}"/>
        <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource Panel}"/>
        <SolidColorBrush x:Key="BrushStroke" Color="{StaticResource Stroke}"/>
        <SolidColorBrush x:Key="BrushInk" Color="{StaticResource Ink}"/>

        <!-- Generic Card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushStroke}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Pokedex Button -->
        <Style x:Key="PokeButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFD9D9D9"/>
            <Setter Property="Background" Value="#FFF2F2F2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFEAEAEA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFE0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PokeButtonPrimary" TargetType="Button" BasedOn="{StaticResource PokeButton}">
            <Setter Property="Background" Value="{StaticResource BrushRed1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushRed2}"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushRed2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox -->
        <Style x:Key="PokeTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#FFD9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="PokeComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- FIXED TabItem (shows headers always) -->
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="#FFF2F2F2"
                                BorderBrush="#FFDADADA"
                                BorderThickness="1"
                                CornerRadius="12,12,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushRed2}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFEAEAEA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== ANIMATIONS ===================== -->
        <Storyboard x:Key="AttackDashLeft">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="120" Duration="0:0:0.12" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="AttackDashRight">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="-120" Duration="0:0:0.12" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="DamageShake">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.04" Value="10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="-10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="8"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="-8"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="DamageFlash">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             To="0.35" Duration="0:0:0.07" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="HealPulse">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)"
                             To="1.12" Duration="0:0:0.12" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)"
                             To="1.12" Duration="0:0:0.12" AutoReverse="True"/>
        </Storyboard>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Pokéball watermark -->
        <Grid IsHitTestVisible="False">
            <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-120,-140,0"
                     Stroke="#30FFFFFF" StrokeThickness="26" Fill="#10FFFFFF"/>
            <Ellipse Width="170" Height="170" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,40,30,0"
                     Stroke="#30FFFFFF" StrokeThickness="26" Fill="Transparent"/>
        </Grid>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" CornerRadius="0,0,24,24" Padding="18"
                Background="{StaticResource BrushRed1}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="22"
                        Background="White" BorderBrush="#88FFFFFF" BorderThickness="2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" Opacity="0.25"/>
                    </Border.Effect>
                    <Grid>
                        <Ellipse Width="16" Height="16" Fill="#FF78D7FF"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="POKÉDEX" FontFamily="{StaticResource UiFont}"
                               Foreground="White" FontSize="22"
                               FontWeight="Black"/>
                    <TextBlock Text="Search • Add • Games • Battle"
                               Foreground="#EEFFFFFF" Opacity="0.95"/>
                </StackPanel>

                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                           Foreground="#EEFFFFFF"
                           FontWeight="SemiBold"
                           Text="Gen 1 Edition"/>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="12">
            <Border Style="{StaticResource Card}" Background="{StaticResource BrushPanel}">
                <TabControl Margin="8">

                    <!-- TAB 1: POKEDEX -->
                    <TabItem Header="Pokédex">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="620"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT -->
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <DockPanel>

                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="SearchBox"
                                                 Style="{StaticResource PokeTextBox}"
                                                 TextChanged="SearchBox_TextChanged"
                                                 KeyDown="SearchBox_KeyDown"/>

                                        <ComboBox x:Name="TypeFilter" Grid.Column="2"
                                                  Style="{StaticResource PokeComboBox}"
                                                  SelectionChanged="TypeFilter_SelectionChanged"/>

                                        <Button Grid.Column="4"
                                                Style="{StaticResource PokeButtonPrimary}"
                                                Content="Add (web)"
                                                Click="AddFromWeb_Click"/>

                                        <Button Grid.Column="6"
                                                Style="{StaticResource PokeButton}"
                                                Content="Import 151"
                                                Click="Import151_Click"/>
                                    </Grid>

                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Style="{StaticResource PokeButton}" Width="90" Content="Add" Click="Add_Click"/>
                                        <Button Style="{StaticResource PokeButton}" Width="90" Margin="10,0,0,0" Content="Delete" Click="Delete_Click"/>
                                        <Button Style="{StaticResource PokeButton}" Width="120" Margin="10,0,0,0" Content="Reset demo" Click="ResetDemo_Click"/>
                                    </StackPanel>

                                    <TextBlock x:Name="StatusText" Opacity="0.75" Margin="0,0,0,10"/>

                                    <DataGrid x:Name="PokemonGrid"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="False"
                                              SelectionChanged="PokemonGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                            <DataGridTextColumn Header="HP" Binding="{Binding HP, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                            <DataGridTextColumn Header="Atk" Binding="{Binding Attack, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                            <DataGridTextColumn Header="Def" Binding="{Binding Defense, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="Tip: kliknij komórkę w tabeli aby edytować."
                                               Opacity="0.55" Margin="0,10,0,0"/>
                                </DockPanel>
                            </Border>

                            <!-- RIGHT DETAILS -->
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="DetailsName" FontSize="28" FontWeight="Black" Foreground="{StaticResource BrushInk}"/>
                                    <TextBlock x:Name="DetailsType" Grid.Row="1" Opacity="0.7" Margin="0,4,0,10"/>

                                    <Border Grid.Row="2" CornerRadius="16" Background="#FFF6F9FF" BorderBrush="#FFE5EDFF" BorderThickness="1" Padding="12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image x:Name="DetailsImage" Width="240" Height="240" Stretch="Uniform"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                        <TextBlock x:Name="DetailsDesc" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12"/>
                                        <TextBlock x:Name="DetailsStats" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: GUESS -->
                    <TabItem Header="Game 1: Guess">
                        <Grid Margin="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Guess the Pokémon" FontSize="24" FontWeight="Black" Margin="0,0,0,10"/>
                                    <Border CornerRadius="16" Background="#FFF6F9FF" BorderBrush="#FFE5EDFF" BorderThickness="1" Padding="12">
                                        <Image x:Name="GuessImage" Width="260" Height="260" Stretch="Uniform" Opacity="0.25"/>
                                    </Border>
                                    <TextBlock Text="(sprite is faded)" Opacity="0.6" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="GuessScoreText" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBox x:Name="GuessInputBox" Style="{StaticResource PokeTextBox}" Margin="0,12,0,0"
                                             KeyDown="GuessInputBox_KeyDown"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Style="{StaticResource PokeButtonPrimary}" Content="Check" Width="100" Click="GuessCheck_Click"/>
                                        <Button Style="{StaticResource PokeButton}" Content="Next" Width="100" Margin="10,0,0,0" Click="GuessNext_Click"/>
                                        <Button Style="{StaticResource PokeButton}" Content="Reveal" Width="100" Margin="10,0,0,0" Click="GuessReveal_Click"/>
                                    </StackPanel>

                                    <TextBlock x:Name="GuessMessageText" Margin="0,12,0,0" FontSize="14"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: TYPE QUIZ -->
                    <TabItem Header="Game 2: Type Quiz">
                        <Grid Margin="18">
                            <Border Style="{StaticResource Card}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                                    <TextBlock Text="Type Match Quiz" FontSize="24" FontWeight="Black" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="TypeQuizScoreText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                    <Border CornerRadius="16" Background="#FFF6F9FF" BorderBrush="#FFE5EDFF" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="TypeQuizNameText" FontSize="24" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Choose the correct type:" Opacity="0.7" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <UniformGrid Columns="2" Rows="2" Margin="0,0,0,10">
                                        <Button x:Name="TypeBtn1" Style="{StaticResource PokeButton}" Margin="6" Height="46" Click="TypeAnswer_Click"/>
                                        <Button x:Name="TypeBtn2" Style="{StaticResource PokeButton}" Margin="6" Height="46" Click="TypeAnswer_Click"/>
                                        <Button x:Name="TypeBtn3" Style="{StaticResource PokeButton}" Margin="6" Height="46" Click="TypeAnswer_Click"/>
                                        <Button x:Name="TypeBtn4" Style="{StaticResource PokeButton}" Margin="6" Height="46" Click="TypeAnswer_Click"/>
                                    </UniformGrid>

                                    <Button Style="{StaticResource PokeButtonPrimary}" Content="Next Question" Height="38" Width="180"
                                            Click="TypeNext_Click"/>

                                    <TextBlock x:Name="TypeQuizMessageText" Margin="0,12,0,0" FontSize="14" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 4: BATTLE -->
                    <TabItem Header="Game 3: Battle">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="14">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFF7FBFF" Offset="0"/>
                                        <GradientStop Color="#FFF0F5FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Player 1" FontSize="16" FontWeight="Black"/>
                                        <ComboBox x:Name="P1Selector" Style="{StaticResource PokeComboBox}" Margin="0,10,0,0"
                                                  DisplayMemberPath="Name" SelectionChanged="P1Selector_SelectionChanged"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Player 2" FontSize="16" FontWeight="Black"/>
                                        <ComboBox x:Name="P2Selector" Style="{StaticResource PokeComboBox}" Margin="0,10,0,0"
                                                  DisplayMemberPath="Name" SelectionChanged="P2Selector_SelectionChanged"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Button Style="{StaticResource PokeButtonPrimary}" Content="START BATTLE"
                                                Width="180" Click="StartBattle_Click"/>
                                        <TextBlock x:Name="RoundInfoText" Margin="0,10,0,0"
                                                   HorizontalAlignment="Center" Opacity="0.85"
                                                   FontWeight="SemiBold"
                                                   Text="Round 1 | P1: 0  -  P2: 0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Border x:Name="P1Indicator" Height="10" CornerRadius="5" Background="Transparent"/>
                                        <TextBlock x:Name="P1NameText" FontWeight="Bold" Margin="0,8,0,0"/>
                                        <ProgressBar x:Name="P1HPBar" Height="16" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="P1HPText" Opacity="0.8" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Border x:Name="P2Indicator" Height="10" CornerRadius="5" Background="Transparent"/>
                                        <TextBlock x:Name="P2NameText" FontWeight="Bold" Margin="0,8,0,0"/>
                                        <ProgressBar x:Name="P2HPBar" Height="16" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="P2HPText" Opacity="0.8" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border CornerRadius="18" Background="#FFF6F9FF" BorderBrush="#FFE5EDFF" BorderThickness="1" Padding="12">
                                                <Image x:Name="P1Image" Width="220" Height="220" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                                    <Image.RenderTransform>
                                                        <TransformGroup>
                                                            <TranslateTransform X="0" Y="0"/>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </TransformGroup>
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Border>
                                        </Grid>

                                        <Border Grid.Column="1" CornerRadius="18" Background="White" BorderBrush="#FFE2E2E2"
                                                BorderThickness="1" Padding="12"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel x:Name="BattleControls" IsEnabled="False">
                                                <Button x:Name="BtnAttack" Style="{StaticResource PokeButton}" Content="Attack" Margin="0,6,0,6" Click="Attack_Click"/>
                                                <Button x:Name="BtnHeavy"  Style="{StaticResource PokeButton}" Content="Heavy"  Margin="0,6,0,6" Click="Heavy_Click"/>
                                                <Button x:Name="BtnHeal"   Style="{StaticResource PokeButton}" Content="💊 HEAL" Margin="0,6,0,6" Click="Heal_Click"/>
                                                <Button x:Name="BtnUlt"    Style="{StaticResource PokeButton}" Content="✨ ULTIMATE" Margin="0,6,0,6" Click="Ult_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border CornerRadius="18" Background="#FFF6F9FF" BorderBrush="#FFE5EDFF" BorderThickness="1" Padding="12">
                                                <Image x:Name="P2Image" Width="220" Height="220" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                                    <Image.RenderTransform>
                                                        <TransformGroup>
                                                            <TranslateTransform X="0" Y="0"/>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </TransformGroup>
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <TextBlock x:Name="BattleLog" FontFamily="Consolas" FontSize="14"
                                               TextWrapping="Wrap"
                                               Text="Select fighters and press START BATTLE"/>
                                </Border>

                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
